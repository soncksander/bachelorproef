  "instructions": [
    {
      "step_number": 1,
      "text": "Remove the skin from the chicken legs, put them in a bowl and pull the meat apart."
    },
    {
      "step_number": 2,
      "text": "Peel the red onion and chop finely. Peel the eggs and mash with a fork. Finely chop the gherkins, pearl onions, and chives and mix everything together."
    },
    {
      "step_number": 3,
      "text": "Mix the yogurt, lemon juice, and mustard into the mayonnaise, and stir into the chicken salad. Season with pepper and salt."
    },
    {
      "step_number": 4,
      "text": "Rinse the lettuce and spin dry. Cut thick slices of the rustic bread and top with chicken salad and lamb's lettuce or serve separately."
    }
  ]
