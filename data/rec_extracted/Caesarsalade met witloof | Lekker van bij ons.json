  "instructions": [
    {
      "step_number": 1,
      "text": "Season the chicken thigh meat with curry powder, pepper, and salt. Fry until cooked and crispy in a hot pan."
    },
    {
      "step_number": 2,
      "text": "Wash the lettuce, spinach, and chicory. Cut the lettuce into large pieces."
    },
    {
      "step_number": 3,
      "text": "Arrange the lettuce, spinach, and chicory leaves in a large bowl."
    },
    {
      "step_number": 4,
      "text": "Boil the eggs for 10 minutes, cool in cold water. Peel and cut in half."
    },
    {
      "step_number": 5,
      "text": "Mix the mayonnaise with the anchovies, lemon juice, and parsley. Season to taste with pepper and olive oil, and optionally some extra lemon juice."
    },
    {
      "step_number": 6,
      "text": "Drizzle the salad with olive oil and season with fleur de sel."
    },
    {
      "step_number": 7,
      "text": "Pick the meat from the chicken thighs and cut or tear into pieces. Distribute over the salad along with the eggs and some anchovy fillets."
    },
    {
      "step_number": 8,
      "text": "Spoon plenty of the dressing over. Finish with coarsely grated cheese, fresh parsley, and lemon zest."
    }
  ]
