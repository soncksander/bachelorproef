  "instructions": [
    {
      "step_number": 1,
      "text": "Preheat the oven to 170\u00b0C."
    },
    {
      "step_number": 2,
      "text": "Slice the mushrooms and cut the spring onions into rings. Cut the ham into cubes."
    },
    {
      "step_number": 3,
      "text": "Beat the eggs with the milk. Fold in the cheese. Cut the bread into cubes and mix into the egg mixture. Add the broccoli florets, mushrooms, spring onions, and ham, season with thyme, pepper, and salt, and mix everything well."
    },
    {
      "step_number": 4,
      "text": "Spoon everything into a buttered oven dish of about 20x20 cm. Place the dish in the oven for 45 minutes to an hour."
    },
    {
      "step_number": 5,
      "text": "Finish with the basil before serving."
    }
  ]
