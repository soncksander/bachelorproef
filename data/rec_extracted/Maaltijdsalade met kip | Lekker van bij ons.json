  "instructions": [
    {
      "step_number": 1,
      "text": "Finely chop the garlic. Halve the chili pepper, remove the seeds, and chop finely. Mix all ingredients and season with pepper and salt. Chill."
    },
    {
      "step_number": 2,
      "text": "Mix the dried marjoram and oregano with the dried onion, pepper, and salt in a large bowl. Cut the chicken fillet into strips and mix them well with the herbs."
    },
    {
      "step_number": 3,
      "text": "Fry the chicken strips until golden brown in a large pan with butter and olive oil. Lower the heat and continue frying until the chicken is cooked through. Let cool."
    },
    {
      "step_number": 4,
      "text": "Cut the lettuce into bite-sized pieces, halve the cherry tomatoes, and slice the snack cucumbers. Finely chop the red onion."
    },
    {
      "step_number": 5,
      "text": "Divide the lettuce, cherry tomatoes, and cucumber over a large dish and mix in a third of the dressing. Add the chicken strips and mix everything gently. Spoon the rest of the dressing over and finish with the red onion."
    }
  ]
