  "instructions": [
    {
      "step_number": 1,
      "text": "Mix the flour with the baking powder, sugar and salt in a bowl or with a stand mixer."
    },
    {
      "step_number": 2,
      "text": "First add the melted butter and the beaten eggs. Then add the milk and whisk until you have a light batter."
    },
    {
      "step_number": 3,
      "text": "Bake pancakes about 8 to 10 cm in diameter in a pan with some butter. Once the bubbles open and the batter becomes drier, you can bake the other side for another half a minute."
    },
    {
      "step_number": 4,
      "text": "Bake all the pancakes this way, serve with the blueberries, some raspberries and honey."
    }
  ]
