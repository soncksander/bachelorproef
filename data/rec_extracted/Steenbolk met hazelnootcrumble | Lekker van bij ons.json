  "instructions": [
    {
      "step_number": 1,
      "text": "Breng een ruime pot water met het bouillonblokje aan de kook. Kook de aardappel- en butternutblokjes 4 minuten beetgaar. Giet af en laat goed uitlekken."
    },
    {
      "step_number": 2,
      "text": "Meng de peterselie, tijm, salie, hazelnoten, geraspte kaas en de geperste knoflook. Voeg de zachte boter toe en meng tot een kruimelig geheel."
    },
    {
      "step_number": 3,
      "text": "Verwarm de oven voor op 180 \u00b0C."
    },
    {
      "step_number": 4,
      "text": "Leg de steenbolkfilets op een met bakpapier beklede bakplaat en kruid met peper en zout. Verdeel de crumble over de vis."
    },
    {
      "step_number": 5,
      "text": "Bak de steenbolk 10 \u00e0 12 minuten in de oven, tot de vis gaar is en de crumble mooi goudbruin kleurt."
    },
    {
      "step_number": 6,
      "text": "Snipper de rode ui fijn. Rits de blaadjes van de tijm."
    },
    {
      "step_number": 7,
      "text": "Smelt een klontje boter in een ruime pan en stoof de rode ui samen met de knoflook, de tijm en het laurierblaadje glazig. Voeg de voorgekookte aardappel- en butternutblokjes toe en bak ze enkele minuten goudbruin. Roer de fijngehakte salie erdoor en kruid met peper en zout."
    },
    {
      "step_number": 8,
      "text": "Verdeel de groenten over de borden. Leg er de steenbolkfilets op en werk af met de rucola."
    }
  ]
