  "instructions": [
    {
      "step_number": 1,
      "text": "Heat oil on medium high and add cumin seed and sizzle 30 sec. be careful not to burn"
    },
    {
      "step_number": 2,
      "text": "Add onions and saut\u00e9 8 min or until golden and brown."
    },
    {
      "step_number": 3,
      "text": "Stir in tomatoes, salt, ginger and jalapeno and stir well."
    },
    {
      "step_number": 4,
      "text": "Saut\u00e9 mixture for 5- 8 min then stir in chick peas and coconut milk. Bring to a boil, reduce the heat to medium low then cover and simmer for 5 to 8 min (stir once or twice during this time)."
    },
    {
      "step_number": 5,
      "text": "Add green onions stir and simmer for one or two more minutes then turn off heat."
    }
  ]
