  "instructions": [
    {
      "step_number": 1,
      "text": "Pot #1: Bring rice and water to a boil in a pot. Reduce heat to low, cover, simmer 25 min."
    },
    {
      "step_number": 2,
      "text": "Pan: Heat oil, add chicken and saut\u00e9 lightly until cooked through."
    },
    {
      "step_number": 3,
      "text": "Pot #2: Whisk together curry paste and 1 can coconut milk. Mix in remaining coconut milk, chicken, fish sauce, sugar, and bamboo shoots. Bring to a boil. Simmer 15 min."
    },
    {
      "step_number": 4,
      "text": "Mix the red bell pepper, green bell pepper, and onion. Cook 10 more min."
    },
    {
      "step_number": 5,
      "text": "Remove from heat. Stir in pineapple. Serve over the cooked rice."
    }
  ]
