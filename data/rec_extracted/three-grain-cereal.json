  "instructions": [
    {
      "step_number": 1,
      "text": "Preheat oven to 325 F."
    },
    {
      "step_number": 2,
      "text": "Spray baking sheet with cooking oil spray."
    },
    {
      "step_number": 3,
      "text": "Combine first 4 ingredients, stirring with a whisk."
    },
    {
      "step_number": 4,
      "text": "Combine oats, barley, walnuts, wheat germ, cinnamon, and nutmeg in a large bowl. Add syrup mixture; stir well to coat. Spread oat mixture evenly onto a baking sheet."
    },
    {
      "step_number": 5,
      "text": "Bake at 325 F for 30 min. or until browned, gently turning mixture every 10 minutes so grains baked evenly."
    },
    {
      "step_number": 6,
      "text": "Remove and stir in chopped dried fruit. Cool completely."
    },
    {
      "step_number": 7,
      "text": "Note: Store in an airtight container for up to 5 days."
    }
  ]
}