  "instructions": [
    {
      "step_number": 1,
      "text": "Heat oil in large non-stick pan on medium-high heat."
    },
    {
      "step_number": 2,
      "text": "Add chops; cook 6 min. Turn after 3 minutes. Remove from skillet and cover to keep warm."
    },
    {
      "step_number": 3,
      "text": "Add onions to same pan. Cook 5 min. stirring occasionally."
    },
    {
      "step_number": 4,
      "text": "Stir in rice, peppers, broth, dressing and rosemary. Reduce heat to medium-low. Simmer 15 min."
    },
    {
      "step_number": 5,
      "text": "Serve chops over rice, quinoa or barley dish and some colorful vegetables."
